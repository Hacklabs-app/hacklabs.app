rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /waitlist/{email} {
      // Allow existence checks and fetching own entry
      allow get: if true; 
      
      // Allow creation of new entries
      allow create: if request.resource.id == email
                   && request.resource.data.email == email
                   && request.resource.data.name is string
                   && request.resource.data.tos == true
                   && request.resource.data.fields is list;
      
      // Prevent unauthorized listing or modification
      allow list, update, delete: if false;
    }
  }
}
